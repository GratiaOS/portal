{
  "name": "El portal",
  "port": 3100,
  "host": "127.0.0.1",
  "dbPath": "data/portal.db",
  "tokensFile": "portal.tokens.local.json",
  "participants": [
    { "kind": "human", "alias": "quartz", "sign": "💠" },
    { "kind": "human", "alias": "forge", "sign": "🔩" },
    { "kind": "human", "alias": "relay", "sign": "📡" },
    { "kind": "human", "alias": "pulse", "sign": "⚡" },
    { "kind": "human", "alias": "local", "sign": "🔋" },
    { "kind": "human", "alias": "rdm", "sign": "🔥" },
    { "kind": "companion", "alias": "Nova", "capabilities": ["answer"] }
  ],
  "rooms": [
    { "id": "general", "title": "General" },
    { "id": "ops", "title": "Ops", "tags": ["infra"] }
  ],
  "rateLimit": { "messages": 10, "perSeconds": 10 },
  "maxStreamsPerParticipant": 10,
  "retention": { "days": 14, "messages": 999 },
  "nova": {
    "alias": "Nova",
    "llm": {
      "baseUrl": "https://your-llm-host/v1",
      "model": "auto",
      "apiKeyEnv": "PORTAL_LLM_API_KEY",
      "maxTokens": 4000
    },
    "knowledgeDir": "path/to/your/knowledge",
    "contextTurns": 12,
    "maxQueue": 5,
    "exclude": ["private/interfaces"],
    "facts": ["The portal is run by the infrastructure team."],
    "examples": ["who is on call this week?", "where do we keep the runbooks?"]
  }
}
