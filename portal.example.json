{
  "port": 3100,
  "host": "127.0.0.1",
  "dbPath": "data/portal.db",
  "tokensFile": "portal.tokens.local.json",
  "participants": [
    { "kind": "human", "alias": "Zeus", "locale": "ro", "sign": "🦁" },
    { "kind": "human", "alias": "Hera", "locale": "ro" },
    { "kind": "companion", "alias": "Nova", "capabilities": ["answer"] }
  ],
  "rooms": [
    { "id": "general", "title": "General" },
    { "id": "olympus", "title": "Olympus", "tags": ["myths"] }
  ],
  "rateLimit": { "messages": 10, "perSeconds": 10 },
  "maxStreamsPerParticipant": 10,
  "retention": { "days": 14, "messages": 999 },
  "nova": {
    "alias": "Nova",
    "llm": {
      "baseUrl": "https://your-llm-host/v1",
      "model": "auto",
      "apiKeyEnv": "PORTAL_LLM_API_KEY",
      "maxTokens": 4000
    },
    "knowledgeDir": "path/to/your/knowledge",
    "contextTurns": 12,
    "maxQueue": 5,
    "exclude": ["private/interfaces"],
    "facts": ["The portal is run by the Olympus infrastructure team."],
    "examples": ["who guards the gates of Olympus?", "what happens to a god who breaks the oath on the Styx?"]
  }
}
