{
  // The portal's second home: one Worker, and one Durable Object that is the whole portal. See ../INSTALL.md, "On Cloudflare".
  // Its config and tokens are secrets (PORTAL_CONFIG, PORTAL_TOKENS), never this file: a portal's people are its own.
  "name": "portal",
  "main": "worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // the page, built by `pnpm --filter portal-ui build`; the Worker sees every request first, to send /api to the portal and
  // the page with the same headers as in Node
  "assets": { "directory": "../ui/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "PORTAL", "class_name": "Portal" }] },
  // `v3` is a marker with nothing in it, kept on purpose and not a step: a Worker that has already applied it (firegate.space, which once had an object for the tree on the gate, since deleted) must find
  // its last tag here, or wrangler applies every migration again over it. Anyone else gets `v1`, and `v3` changes nothing. The tree breathes on the page, from the clock, and needs no object.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Portal"] }, { "tag": "v3" }]
}
