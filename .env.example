# Copy to .env in this folder (gitignored). Never commit the real values.

# Any OpenAI-compatible chat-completions endpoint (company gateway, LM Studio, vLLM, OpenRouter...)
PORTAL_LLM_BASE_URL=https://your-llm-host/v1
PORTAL_LLM_MODEL=auto
PORTAL_LLM_API_KEY=

# Optional: low | medium | high (sent as reasoning_effort when set)
PORTAL_LLM_REASONING_EFFORT=
